# Public HTTPS origin of this broker (no path). Must match the Google OAuth client.
PUBLIC_BASE_URL=https://photos-pair.example.com
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Server-side only. Never copy into the KOReader plugin.
GOOGLE_CLIENT_SECRET=replace-me
# openssl rand -base64 32   (losing it invalidates all paired devices)
TOKEN_ENCRYPTION_KEY=
DATA_FILE=./data/devices.json
HOST=127.0.0.1
PORT=8787
# Set to 1 only behind a trusted reverse proxy (per-IP rate limits use X-Forwarded-For).
TRUST_PROXY=0
PAIRING_TTL_SECONDS=600
# Local development only: allows http://localhost / 127.0.0.1 PUBLIC_BASE_URL.
# ALLOW_INSECURE_LOOPBACK=1
