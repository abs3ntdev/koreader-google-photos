# Copy to broker.env (gitignored), chmod 600. Never commit real values.
# Public HTTPS origin served by your reverse proxy (no path). Must match the Google OAuth client
# redirect URI: <PUBLIC_BASE_URL>/oauth/callback
PUBLIC_BASE_URL=https://photos-pair.example.com
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# openssl rand -base64 32. Keep it stable and back it up separately from appdata:
# losing or changing it invalidates every paired device.
TOKEN_ENCRYPTION_KEY=
# 1 because the container sits behind a reverse proxy (per-IP rate limits use X-Forwarded-For).
TRUST_PROXY=1
PAIRING_TTL_SECONDS=600
# Do NOT set ALLOW_INSECURE_LOOPBACK in a container deployment.
