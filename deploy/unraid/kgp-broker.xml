<?xml version="1.0"?>
<!-- Unraid user template. Copy to /boot/config/plugins/dockerMan/templates-user/my-kgp-broker.xml
     The image is NOT on a public registry: build/import it on the server first as
     koreader-google-photos-broker:local (see docs/DEPLOY.md). -->
<Container version="2">
  <Name>kgp-broker</Name>
  <Repository>koreader-google-photos-broker:local</Repository>
  <Registry/>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project/>
  <Overview>KOReader Google Photos pairing broker. Must sit behind an HTTPS reverse proxy. Runs as 99:100; appdata dir must be owned by 99:100 and mode 700.</Overview>
  <Category>Tools:</Category>
  <WebUI/>
  <TemplateURL/>
  <Icon/>
  <ExtraParams>--user 99:100 --restart unless-stopped --read-only --tmpfs /tmp --security-opt no-new-privileges:true --cap-drop ALL</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires>HTTPS reverse proxy (e.g. SWAG, Nginx Proxy Manager). Appdata: mkdir -p /mnt/user/appdata/kgp-broker; chown 99:100 and chmod 700 that directory only.</Requires>
  <Config Name="Appdata" Target="/config" Default="/mnt/user/appdata/kgp-broker" Mode="rw" Description="Holds data/devices.json (encrypted refresh tokens). Owned by 99:100, mode 700." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/kgp-broker</Config>
  <Config Name="HTTP port" Target="8787" Default="8787" Mode="tcp" Description="Plain HTTP; expose only to the reverse proxy." Type="Port" Display="always" Required="true" Mask="false">8787</Config>
  <Config Name="PUBLIC_BASE_URL" Target="PUBLIC_BASE_URL" Default="" Mode="" Description="Public https origin, no path. Google redirect URI = this + /oauth/callback" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="GOOGLE_CLIENT_ID" Target="GOOGLE_CLIENT_ID" Default="" Mode="" Description="Google OAuth web client id" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="GOOGLE_CLIENT_SECRET" Target="GOOGLE_CLIENT_SECRET" Default="" Mode="" Description="Google OAuth client secret" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="TOKEN_ENCRYPTION_KEY" Target="TOKEN_ENCRYPTION_KEY" Default="" Mode="" Description="openssl rand -base64 32. Back it up; changing it invalidates all paired devices." Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="TRUST_PROXY" Target="TRUST_PROXY" Default="1" Mode="" Description="1 behind a trusted reverse proxy" Type="Variable" Display="advanced" Required="false" Mask="false">1</Config>
  <Config Name="PAIRING_TTL_SECONDS" Target="PAIRING_TTL_SECONDS" Default="600" Mode="" Description="60..1800" Type="Variable" Display="advanced" Required="false" Mask="false">600</Config>
</Container>
